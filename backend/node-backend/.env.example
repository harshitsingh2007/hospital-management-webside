# Node.js Backend Production Environment Configuration
NODE_ENV=production
PORT=8000

# PostgreSQL Connection String (Azure Flexible Server with SSL)
DATABASE_URL=postgresql://dbuser:ComplexPassword123!@your-azure-pg.postgres.database.azure.com:5432/hospital_db?sslmode=require

# Frontend Production URL (CORS allowed origin, without trailing slash)
FRONTEND_URL=https://hospital.yourdomain.com

# Cryptographic JWT Secret (Minimum 32 characters)
JWT_SECRET=production_super_strong_jwt_secret_key_at_least_32_chars_2026_secure!

# Python AI Internal Service Shared Secret (Minimum 16 characters)
AI_INTERNAL_SECRET=prod_ai_internal_secret_key_2026_at_least_16_chars_secure

# Internal Python AI Microservice URL
PYTHON_AI_URL=http://localhost:5001

# Disable legacy email authentication fallback in production
ALLOW_LEGACY_EMAIL_AUTH=false

# SMTP / Email Service (Optional for transactional emails)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@yourhospitaldomain.com
