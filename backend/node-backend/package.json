{
  "name": "ai-queue-node-backend",
  "version": "1.0.0",
  "description": "Enterprise Multi-Hospital AI Queue System Backend in Node.js & Express with Prisma ORM and Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node --watch -r ./loadEnv.js src/server.js",
    "dev": "node --watch -r ./loadEnv.js src/server.js",
    "prisma:pull": "node scripts/run-prisma.js db pull",
    "prisma:generate": "node scripts/run-prisma.js generate",
    "test": "node -r ./loadEnv.js tests/run_all_tests.js",
    "db:clean-dummy": "node -r ./loadEnv.js src/utils/cleanDummyData.js"
  },
  "keywords": [
    "express",
    "prisma",
    "postgresql",
    "socket.io",
    "queue-system",
    "ai"
  ],
  "author": "Google DeepMind / Antigravity",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "prisma": "^5.19.1",
    "socket.io-client": "^4.8.3"
  }
}
