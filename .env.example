# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_queue"

# ------------------------------------------------------------------------------
# 2. SERVER & RUNTIME PORTS
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_PORT=8001

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET="replace_with_a_secure_jwt_secret_key"
JWT_EXPIRES_IN="15m"

# ------------------------------------------------------------------------------
# 4. CLINICAL LOCALIZATION & SECURITY
# ------------------------------------------------------------------------------
HOSPITAL_TIMEZONE="Asia/Kolkata"

# WARNING: ALLOW_LEGACY_EMAIL_AUTH permits authentication via X-User-Email / X-User-Phone headers without a JWT token.
# Keep this set to "false" in production. Only set to "true" during migration or debugging.
# Default: false
ALLOW_LEGACY_EMAIL_AUTH=false

# ------------------------------------------------------------------------------
# 5. EMAIL / SMTP DISPATCH CONFIGURATION (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Hospital Management <noreply@hospital.com>"

# ------------------------------------------------------------------------------
# 6. MOBILE SMS GATEWAY DISPATCH
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""

